# Application
PORT=3008
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:admin@localhost:5432/keycloak_demo-new

# Keycloak OIDC
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=keycloak-demo
KEYCLOAK_CLIENT_ID=keycloak-demo-app
# Issuer must match the `iss` claim in access tokens
KEYCLOAK_ISSUER=http://localhost:8180/realms/keycloak-demo

# Confidential client for Admin REST API (user / role management)
KEYCLOAK_ADMIN_CLIENT_ID=keycloak-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=UMnoXBZMY6bJ4nJZTw3gZWSNfonUKiru

# Invitation email (Nodemailer SMTP). For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: configure a Google identity provider in Keycloak so invited Gmail users can sign in.
# Add this Authorized redirect URI in Google Cloud Console:
# http://localhost:8180/realms/keycloak-demo/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
