# Application
PORT=3008
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:admin@localhost:5432/keycloak_demo-new

# Keycloak OIDC
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=keycloak-demo
KEYCLOAK_CLIENT_ID=keycloak-demo-app
# Issuer must match the `iss` claim in access tokens
KEYCLOAK_ISSUER=http://localhost:8180/realms/keycloak-demo

# Confidential client for Admin REST API (user / role management)
KEYCLOAK_ADMIN_CLIENT_ID=keycloak-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=UMnoXBZMY6bJ4nJZTw3gZWSNfonUKiru

# Google OAuth client (Web application). Used for:
#  - the Keycloak Google identity provider, so invited Gmail users can sign in.
#    Authorized redirect URI: http://localhost:8180/realms/keycloak-demo/broker/google/endpoint
#  - sending invitation emails through the Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Invitation email (Gmail API over HTTPS, no SMTP).
# GOOGLE_REFRESH_TOKEN must be issued to GOOGLE_CLIENT_ID for GMAIL_USER with the
# https://www.googleapis.com/auth/gmail.send scope.
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=
# Optional, defaults to GMAIL_USER. e.g. "Admin Portal <you@gmail.com>".
# The address must be GMAIL_USER or a verified "Send mail as" alias of it.
MAIL_FROM=
